#!/bin/sh
set -eu
cd "$(dirname "$0")/../test/reference/full-op"
fixture_dir=$(mktemp -d "$PWD/node_modules/.mtls-reference.XXXXXX")
trap 'rm -rf "$fixture_dir"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
ruby mtls-certificates.rb "$fixture_dir"
docker run --rm --network none \
  --mount "type=bind,src=$PWD,dst=/app,readonly" --workdir /app \
  --env "CIBA_TEST_MTLS_DIRECTORY=/app/node_modules/$(basename "$fixture_dir")" \
  node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 \
  node mtls.mjs
